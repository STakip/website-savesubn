<%- include('partials/header') %>

<div class="order-page">
  <a class="back" href="/">← zpět na produkty</a>
  <h1>Objednávka <%= order.public_id %></h1>

  <div class="order-summary card"><div class="card-body">
    <div class="row"><span>Produkt</span><strong><%= order.product_name %></strong></div>
    <div class="row"><span>Množství</span><strong><%= order.quantity %>×</strong></div>
    <div class="row"><span>Cena</span><strong><%= formatPrice(order.amount_cents, order.currency) %></strong></div>
    <div class="row"><span>E-mail</span><strong><%= order.email %></strong></div>
    <div class="row"><span>Stav</span>
      <strong class="status status-<%= order.status %>">
        <%= ({pending:'Čeká na platbu', paid:'Zaplaceno', delivered:'Doručeno', cancelled:'Zrušeno'})[order.status] %>
      </strong>
    </div>
  </div></div>

  <% if (order.status === 'delivered') { %>
    <div class="codes-box">
      <h2>Tvoje kódy</h2>
      <ul class="codes">
        <% codes.forEach(function(c){ %><li><%= c %></li><% }) %>
      </ul>
      <p class="muted small">Kódy jsme poslali i na <%= order.email %>.</p>
    </div>

  <% } else if (order.status === 'cancelled') { %>
    <div class="notice">Objednávka byla zrušena. Pokud jde o omyl, vytvoř prosím novou.</div>

  <% } else if (order.payment_method === 'stripe') { %>
    <div class="notice">Čekáme na potvrzení platby kartou. Po zaplacení se kódy zobrazí zde a přijdou ti e-mailem. Pokud jsi platbu nedokončil, <a href="/">začni znovu</a>.</div>

  <% } else { %>
    <div class="pay-instructions card"><div class="card-body">
      <h2>Dokonči platbu</h2>
      <% if (order.payment_method === 'crypto') { %>
        <p>Pošli přesně <strong><%= formatPrice(order.amount_cents, order.currency) %></strong> v hodnotě <strong><%= settings.crypto_label %></strong> na adresu:</p>
        <code class="copy"><%= settings.crypto_address %></code>
      <% } else { %>
        <p>Pošli <strong><%= formatPrice(order.amount_cents, order.currency) %></strong> bankovním převodem na:</p>
        <code class="copy">IBAN: <%= settings.iban_number %></code>
        <% if (settings.iban_holder) { %><div class="muted small">Majitel účtu: <%= settings.iban_holder %><% if (settings.iban_bank) { %> · <%= settings.iban_bank %><% } %></div><% } %>
        <p class="muted small">Jako poznámku / variabilní symbol uveď číslo objednávky <strong><%= order.public_id %></strong>, ať platbu snadno spárujeme.</p>
      <% } %>

      <form method="post" action="/order/<%= order.public_id %>/note" class="note-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label>Doplň referenci platby (txid / variabilní symbol / poznámka)
          <input type="text" name="note" maxlength="500" value="<%= order.reference || '' %>" placeholder="např. txid nebo VS" />
        </label>
        <button class="btn" type="submit">Uložit a nahlásit platbu</button>
      </form>
      <p class="muted small">Po ověření platby (ručně) ti pošleme kódy na e-mail. Tuto stránku si ulož pro kontrolu stavu.</p>
    </div></div>
  <% } %>
</div>

<%- include('partials/footer') %>
