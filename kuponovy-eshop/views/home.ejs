<%- include('partials/header') %>

<section class="hero">
  <div class="badge">Digitální kódy · doručení na e-mail ihned po zaplacení</div>
  <h1><%= settings.shop_name %></h1>
  <p class="lead"><%= settings.shop_tagline %></p>
</section>

<section class="grid products">
  <% if (products.length === 0) { %>
    <div class="empty">Zatím tu nejsou žádné produkty. <% if (user && user.is_admin) { %><a href="/admin/products/new">Přidej první</a>.<% } %></div>
  <% } %>
  <% products.forEach(function(p){ %>
    <article class="card">
      <% if (p.image_url) { %><div class="card-img" style="background-image:url('<%= p.image_url %>')"></div><% } %>
      <div class="card-body">
        <h2><%= p.name %></h2>
        <% if (p.description) { %><p class="muted"><%= p.description %></p><% } %>
        <div class="price-row">
          <span class="price"><%= formatPrice(p.price_cents, p.currency) %></span>
          <% if (p.stock > 0) { %>
            <span class="stock in">skladem <%= p.stock %></span>
          <% } else { %>
            <span class="stock out">vyprodáno</span>
          <% } %>
        </div>
        <% if (p.stock > 0) { %>
          <a class="btn btn-block" href="/p/<%= p.slug %>">Koupit</a>
        <% } else { %>
          <button class="btn btn-block" disabled>Vyprodáno</button>
        <% } %>
      </div>
    </article>
  <% }) %>
</section>

<%- include('partials/footer') %>
