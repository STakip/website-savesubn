<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : settings.shop_name %> · <%= settings.shop_name %></title>
  <link rel="stylesheet" href="/static/style.css" />
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/">
        <span class="brand-mark"><%= settings.shop_name.trim().charAt(0).toUpperCase() %></span>
        <span class="brand-name"><%= settings.shop_name %></span>
      </a>
      <nav class="nav">
        <a href="/">Produkty</a>
        <% if (user) { %>
          <a href="/account">Můj účet</a>
          <% if (user.is_admin) { %><a href="/admin" class="nav-admin">Admin</a><% } %>
          <form method="post" action="/logout" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button class="linklike" type="submit">Odhlásit</button>
          </form>
        <% } else { %>
          <a href="/login">Přihlásit</a>
          <a href="/register" class="btn btn-sm">Registrace</a>
        <% } %>
      </nav>
    </div>
  </header>
  <% if (flash) { %>
    <div class="wrap"><div class="flash flash-<%= flash.type %>"><%= flash.message %></div></div>
  <% } %>
  <main class="wrap main">
